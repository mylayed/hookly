# Copy to .env.local and fill in. .env.local is git-ignored.
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API Keys). Used only on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paddle Billing (Developer tools -> Authentication). Sandbox keys for development.
PADDLE_API_KEY=
# Client-side token (test_... in sandbox, live_... in production).
PADDLE_CLIENT_TOKEN=
# Price id of Pro (pri_...); `npm run paddle:setup` creates it and prints the id.
PADDLE_PRO_PRICE_ID=
# Secret key of the notification destination (webhook).
PADDLE_WEBHOOK_SECRET=
# Optional: sandbox | production (defaults from the API key).
# PADDLE_ENV=sandbox

# Public URL of the app, for sign-in links and the Google redirect.
# Defaults to the request origin (fine for localhost).
# SITE_URL=https://hookly.app

# Optional overrides (defaults in src/lib/analyzer/config.ts)
# HOOKCHECK_ANALYZE_MODEL=claude-sonnet-5
# HOOKCHECK_REWRITE_MODEL=claude-opus-5
# HOOKCHECK_ANALYZE_EFFORT=medium
# HOOKCHECK_HOOKS_EFFORT=medium
# HOOKCHECK_REWRITE_EFFORT=medium

# Free-tier limits per rolling 24 hours (defaults in src/lib/limits.ts)
# HOOKCHECK_LIMIT_ANALYZE=10
# HOOKCHECK_LIMIT_HOOKS=10
# HOOKCHECK_LIMIT_REWRITE=5
# HOOKCHECK_LIMIT_ANALYZE_PER_IP=30
# HOOKCHECK_PRO_LIMIT_ANALYZE=100
# HOOKCHECK_PRO_LIMIT_HOOKS=100
# HOOKCHECK_PRO_LIMIT_REWRITE=40
# HOOKCHECK_DAILY_BUDGET_USD=25
# HOOKCHECK_IP_SALT=
